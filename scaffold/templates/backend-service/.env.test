NODE_ENV=test
PORT=__PORT__

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# Must end in _test_db — src/test/db.ts refuses to run against anything else,
# because truncateAll() would wipe a dev database. Shared across every
# backend service's tests, same as platform_db is for dev.
POSTGRES_DB=platform_test_db
POSTGRES_USER=app_dev
POSTGRES_PASSWORD=app_dev_password

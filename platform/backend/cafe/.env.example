NODE_ENV=development
PORT=4003

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Shared across every backend service — this is not a per-service value.
POSTGRES_DB=platform_db
POSTGRES_USER=app_dev
POSTGRES_PASSWORD=app_dev_password

# Must be at least 16 characters — see src/config/env.schema.ts. Must match
# backend/auth's JWT_SECRET exactly (shared secret, not a new one — this
# service verifies tokens backend/auth signs).
JWT_SECRET=change-me-to-a-real-secret-value

# The browser calls this service directly — never '*'.
CORS_ORIGIN=http://localhost:3001

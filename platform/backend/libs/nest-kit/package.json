{
  "name": "@app/nest-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Nest building blocks every service wires in identically: exception filter, request-id middleware, structured logging. Keeps cross-cutting behaviour consistent instead of reimplemented per service.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@app/contracts": "workspace:*",
    "@nestjs/common": "^11.1.28"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

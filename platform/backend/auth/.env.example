NODE_ENV=development
PORT=4001

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=platform_db
POSTGRES_USER=app_dev
POSTGRES_PASSWORD=app_dev_password

# Must be at least 16 characters — see src/config/env.schema.ts
JWT_SECRET=change-me-to-a-real-secret-value

# The browser calls this service directly — never '*'.
CORS_ORIGIN=http://localhost:3001

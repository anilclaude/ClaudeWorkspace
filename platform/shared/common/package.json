{
  "name": "@app/common",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic utilities usable from a service, the web app, or a script. No Nest imports, no React imports, no Node-only APIs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

# Public by design — the browser calls these services directly, no BFF layer
# in front of them. NEXT_PUBLIC_ is required for Next.js to bundle a value
# into client code; a plain-named var here would silently stay undefined in
# the browser.
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_CORE_SERVICE_URL=http://localhost:4002
NEXT_PUBLIC_CAFE_SERVICE_URL=http://localhost:4003
